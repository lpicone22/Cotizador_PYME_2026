*{box-sizing:border-box}
body{margin:0;background:#eef3f7;font-family:Arial,Helvetica,sans-serif;color:#17233d}
.wrap{max-width:1050px;margin:auto;padding:16px}
.card{background:#fff;border-radius:18px;padding:18px;box-shadow:0 6px 28px rgba(0,0,0,.08);margin-bottom:16px}
h1{margin:0;color:#16427f;font-size:25px}
.sub{color:#667085;margin:5px 0 18px}
.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.span2{grid-column:span 2}
label{font-size:12px;font-weight:700;color:#475467;display:block}
input,select,textarea{width:100%;padding:10px;border:1px solid #cdd7e3;border-radius:9px;margin-top:5px;font-size:15px;background:#fff;font-family:inherit;color:inherit}
input:focus,select:focus,textarea:focus{outline:2px solid #9cc7ee;border-color:#1667b1}
textarea{min-height:72px;resize:vertical}
.section{font-weight:800;color:#16427f;margin:18px 0 10px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.section small{font-weight:400;color:#667085;font-size:12px}
.plans{display:grid;grid-template-columns:repeat(3,1fr);gap:9px}
.plancheck{border:1px solid #d5dfea;border-radius:10px;padding:10px;background:#fbfcfe;cursor:pointer;font-size:14px;color:#17233d}
.plancheck:has(input:checked){border-color:#1667b1;background:#e7f1fb}
.plancheck input{width:auto;margin:0 7px 0 0;vertical-align:middle}
.copay{font-size:11px;color:#667085;margin-left:6px;font-weight:400}
.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:15px}
button{border:0;border-radius:10px;padding:12px 16px;font-weight:800;cursor:pointer;font-size:14px}
.primary{background:#1667b1;color:#fff}
.secondary{background:#e7f1fb;color:#174b86}
.ghost{background:transparent;color:#174b86;padding:6px 10px;border:1px solid #cdd7e3}
.hint{font-size:12px;color:#667085;margin-top:9px;line-height:1.4}
.check-inline{display:flex;align-items:center;gap:8px;font-weight:400;font-size:13px;margin-top:10px}
.check-inline input{width:auto;margin:0}
.toast{position:fixed;left:50%;bottom:20px;transform:translateX(-50%);background:#17233d;color:#fff;padding:10px 16px;border-radius:10px;font-size:14px;opacity:0;pointer-events:none;transition:opacity .25s}
.toast.show{opacity:1}
canvas{width:100%;height:auto;background:#fff;border-radius:10px;margin-top:16px;border:1px solid #e3e9f0}
@media(max-width:800px){.grid,.plans{grid-template-columns:1fr 1fr}}
@media(max-width:520px){.grid,.plans{grid-template-columns:1fr}.span2{grid-column:span 1}}
